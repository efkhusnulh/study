@CONFERENCE{Hasanati2024,
	author = {Hasanati, Nidaul and Ibrahim, Muhamad Ezar and Aini, Qurrotul and Rustamaji, Eri and Nurbojatmiko and Zulfiandri},
	title = {Social Commerce Sentiment Analysis on YouTube Comments with Lexicon-Based and Long Short-Term Memory Methods},
	year = {2024},
	journal = {2024 12th International Conference on Cyber and IT Service Management, CITSM 2024},
	doi = {10.1109/CITSM64103.2024.10775817},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85214937073&doi=10.1109%2fCITSM64103.2024.10775817&partnerID=40&md5=d184d50b410004765a82a7f7f3255b39},
	affiliations = {Uin Syarif Hidayatullah Jakarta, Department of Information Systems, Jakarta, Indonesia},
	abstract = {Recently, social media platforms have included buying and selling features. Some social media platforms have added certain features to facilitate the buying and selling process, hence the term social commerce. TikTok Shop is the most popular social commerce platform user in Indonesia. The phenomenon of TikTok Shop's rapid social commerce growth coincides with the issue of predatory pricing practices that impact the decline in local MSME turnover. There is a lot of discussion about this issue on the YouTube video platform, but the sentiment orientation is not yet clear. This study aims to explore public sentiment related to issues that arise on TikTok Shop using a lexicon-based approach and a deep learning algorithm, namely Long Short-Term Memory (LSTM). 5 popular YouTube video channels that discuss TikTok Shop obtained a total of 14,644 comments. The comment from 14,045 data after passing the text preprocessing stage is labeled with the results of 9,576 data grouped into negative sentiment comments, 2,620 positive comments, and 1,849 neutral comments. The analysis results show that public sentiment on TikTok Shop tends to be negative with most comments expressing concern about the issue of predatory pricing practices that harm MSMEs. This research proves that LSTM is able to classify public sentiment on YouTube comments discussing TikTok Shop based on the results of testing the best hyperparameter combination with the number of neurons as many as 64 units and dropout 0.4 obtained an accuracy value of 92.34%. © 2024 IEEE.},
	author_keywords = {LSTM; sentiment analysis; social commerce; TikTok Shop; YouTube},
	keywords = {Deep learning; Marketplaces; Lexicon-based; Predatory pricing; Pricing practices; Public sentiments; Sentiment analysis; Short term memory; Social commerces; Social media platforms; Tiktok shop; YouTube; Sales},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
