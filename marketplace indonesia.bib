	affiliations = {D4 Business Management, UniversitasLogistik dan BisnisInternasional, Bandung, Indonesia; Faculty of Economics and Business Education, Universitas Pendidikan Indonesia, Bandung, Indonesia; D3 Logistic Management, UniversitasLogistik dan BisnisInternasional, Bandung, Indonesia},
