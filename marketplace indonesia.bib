	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85207853788&doi=10.1109%2fICCIT62134.2024.10701189&partnerID=40&md5=f6d78e38d38d9d51498fe10e1f0b4bf5},
	affiliations = {Bina Nusantara University, Management Department, Jakarta, Indonesia; Universiti Sains Malaysia, Management Department, Penang, Malaysia},
	abstract = {The emergence of TikTok Shop in Indonesia has transformed the e-commerce landscape, blending social media and online shopping. This study aims to find out whether subjective knowledge, social media usage (in this term is TikTok usage), and brand image have a role in influencing impulsive consumer behavior on e-commerce platforms. In this research, Partial Least Squares-Structural Equation Modeling (PLS-SEM) is used for the interpretation and calculation of the gathered data. The results indicate that the presence of TikTok Shop has been shown to significantly influence consumer behavior in Indonesia. The positive and significant relationship between brand image and impulse buying behavior underscores its impact on consumer decision-making and the potential for repeat purchases. It underscores the need for marketers to focus on creating and maintaining a compelling brand identity to effectively engage with consumers and drive impulse purchases. At the same time, the findings highlight the importance of brand image in affecting consumer behavior in the digital age. As the dynamic interplay between social media, e-commerce, and consumer behavior continues to evolve, understanding these interrelationships will be vital for both academia and industry. © 2024 IEEE.},
