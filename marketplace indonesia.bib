	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85209224024&doi=10.1063%2f5.0224338&partnerID=40&md5=58b8731db1c40c926e22b460b64c096c},
	affiliations = {Department of Information Technology, STMIK Insan Pembangunan, Tangerang, Indonesia},
	abstract = {Innovation is a superior process or product and effective commercialization of intellectual property (IP). Innovations can further be developed and protected by registering intellectual property rights (IPR), such as patents, trademarks, industrial designs, and copyrights. Referring to the statistics on IPR applications submitted to the Directorate General of Intellectual Property (DGIP), there is an average increase of between 5% and 20% each year. However, the Indonesian Institute of Sciences and the Ministry of Research and Technology of Indonesia stated that the industry has not widely used patent applications. Nevertheless, there is a considerable gap between the number of patents used and registered patents by industry. This study aims to provide a platform that serves to offer IPRs that have been registered by the DGIP to prospective buyers/prospective commercializes. In this case, the platform name is an intellectual property (IP) marketplace. The study adopts the prototyping method in the intended development platform. After performing several experiments, it decided to use the e-Marketplace platform as the IP Marketplace platform. The platform contains IPR registered, and the following mechanisms can auction it through the licenses, transfer of rights, and franchising. The development of this platform will have implications in supporting IPR owners/holders to commercialize their registered IPRs. © 2024 American Institute of Physics Inc.. All rights reserved.},
	author_keywords = {Directorate General of Intellectual Property; e-Marketplace platform; Intellectual Property Marketplace},
