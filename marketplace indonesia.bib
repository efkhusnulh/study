	keywords = {autoantibody; double stranded DNA; fish oil; interleukin 1beta; tumor necrosis factor; vitamin D; adult; Anabas testudineus; animal experiment; animal model; animal tissue; antigen binding; apoptosis; Article; chemoluminescence; controlled study; enzyme linked immunosorbent assay; gene expression; immune system; inflammation; male; nonhuman; protein expression; rat; synovium; systemic lupus erythematosus; upregulation; Western blotting},
	correspondence_address = {R. Hidayat; Department of Biology, Faculty of Medicine, Universitas Sriwijaya, Palembang, Indonesia; email: yolandaevita@gmail.com},
