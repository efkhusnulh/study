@ARTICLE{Yapp2020178,
	author = {Yapp, Lauren},
	title = {The future in the past: colonial modernity as urban heritage in contemporary Indonesia},
	year = {2020},
	journal = {South East Asia Research},
	volume = {28},
	number = {2},
	pages = {178 – 198},
	doi = {10.1080/0967828X.2020.1768801},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85087111903&doi=10.1080%2f0967828X.2020.1768801&partnerID=40&md5=37ad3853832fc81a6b1a760630eaac1b},
	affiliations = {Cogut Institute for the Humanities, Brown University, Providence, RI, United States},
	abstract = {Across urban Indonesia, the surviving vestiges of ‘modern’ architecture and infrastructure built in the final decades of colonial rule are increasingly being re-defined as ‘heritage’. Through an ethnographic study of Pasar Johar–a striking marketplace in the city of Semarang designed by the Dutch architect and town planner Thomas Karsten in the 1930s–I argue that such cases of modernity-cum-heritage enable the contemporary challenge of hegemonic teleologies of what makes a ‘modern’ city, while also facilitating the perpetuation of insidious colonial-era notions of who counts as a ‘modern’ urban subject. By tracing the ‘afterlives’ of the marketplace and its Dutch creator in present-day debates over the trajectory of Semarang’s development, this article reveals how Indonesian heritage advocates are endeavouring to chart alternative urban futures via their city’s past. Through their lively campaign to save the structure, ‘being modern’ in the postcolonial city comes to be a project not of imitation but of recovery, as well as a passionate critique of urban politics as usual. However, such enthusiastic reclamations of colonial modernity as urban heritage also run the risk of reproducing the same logics of ‘progress’ that once governed the cityscape and its populace a century ago. © 2020, © 2020 SOAS University of London.},
	author_keywords = {anthropology of architecture and infrastructure; Colonial modernity; cultural heritage; Indonesia; postcolonial cities; urban development},
	keywords = {Indonesia; colonialism; future prospect; heritage conservation; town planning; urban design; urban geography; urban planning},
	correspondence_address = {L. Yapp; Cogut Institute for the Humanities, Brown University, Providence, United States; email: lauren_yapp@brown.edu},
	publisher = {Taylor and Francis Ltd.},
	issn = {0967828X},
	language = {English},
	abbrev_source_title = {South East Asia Res.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 10}
