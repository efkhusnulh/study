@ARTICLE{Salim2020234,
	author = {Salim, Eddy Mart and Partan, Radiyati Umi and Hidayat, Rachmat},
	title = {Betok fish (Anabas testudineus) oil decreases inflammatory cytokine through increasing vitamin d level in rats-induced systemic lupus erythematosus},
	year = {2020},
	journal = {Open Access Macedonian Journal of Medical Sciences},
	volume = {8},
	number = {A},
	pages = {234 – 238},
