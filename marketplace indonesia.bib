	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85124665786&doi=10.1109%2fIC-ICTRuDev50538.2021.9656525&partnerID=40&md5=e1044eeda3c953e96b263484f0e60dc1},
	affiliations = {Gunadarma University, Department of Management, Jakarta, Indonesia; Gunadarma University, Department of Management, Jakarta, Indonesia; Gunadarma University, Department of Information System, Jakarta, Indonesia; Central University, Department of Management, Jamia Millia Islamia, New Delhi, India; Ministry of Communication and Informatics, Human Research Resources and Developtment Agency, Jakarta, Indonesia},
	abstract = {Food security is the government's top priority during this pandemic, because the government is trying to ensure that people can still meet their daily food needs even though the government issues policies to limit community activities. The existence of an e-marketplace is an attractive option for the community to meet their food needs without having to do outside activities. E-marketplaces can also be a solution to break the long distribution chain for agricultural products. This study aims to break the long distribution chain of agricultural products through consumer perceptions, trust, and consumer experiences in shopping for agricultural products through e-marketplaces. The sample used in this study are consumers who have purchased agricultural products through e-marketplaces. The data was obtained through a questionnaire using the google form. The results showed that the perceived ease of use, perceived benefits, trust, and experience simultaneously affect the intention to use the e-marketplace of agricultural products. This research study can provide information for the agricultural sector regarding the factors that can affect consumers to use e-marketplaces in obtaining agricultural products. © 2021 IEEE},
