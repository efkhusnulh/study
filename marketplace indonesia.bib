@CONFERENCE{Ikhsan2024483,
	author = {Ikhsan, Ridho Bramulya and Helen and Wijanarko, HM. Rosariandoko and Sayoga, Reagen Yohanes and Prabowo, Hartiwi and Hardiyansyah},
	title = {Social Gratification and Flow State as a Driven to Purchase Intention Using Live Shopping Feature},
