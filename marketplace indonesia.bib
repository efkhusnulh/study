	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1; Conference name: 31st Australasian Conference on Information Systems, ACIS 2019; Conference date: 1 December 2020 through 4 December 2020; Conference code: 192366}
}

