@CONFERENCE{Nelson2024429,
	author = {Nelson and Musthafa, Alwi Erdi and Rumagit, Reinert Yosua and Pratama, Galih Dea},
	title = {Comparison of user interface and user experience between Bukalapak and Blibli in mobile application},
	year = {2024},
	journal = {Procedia Computer Science},
	volume = {245},
