@CONFERENCE{Mayo2024,
	author = {Mayo, Michael and Gerwin and Amadeo and Ferdianto},
	title = {Analysis Factors Influencing User Preferences in Continuance Intention on Music Streaming Services Commerce Among Indonesian Users},
	year = {2024},
	journal = {11th International Conference on ICT for Smart Society: Integrating Data and Artificial Intelligence for a Resilient and Sustainable Future Living, ICISS 2024 - Proceeding},
	doi = {10.1109/ICISS62896.2024.10751151},
