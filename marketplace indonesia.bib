@ARTICLE{2010,
	title = {Natural gas: South Korea: Kogas retains its appetite for LNG imports},
	year = {2010},
	journal = {Petroleum Economist},
	volume = {77},
	number = {1},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-74249113283&partnerID=40&md5=cb9281017a4356a95ff9954356db4e9a},
	abstract = {Korea Gas Corp (Kogas), the world's largest corporate buyer of LNG, remains eager to secure new supplies despite the global gas glut. South Korea imported 2.48 million ton of LNG in October 2009, up by 37% from 2008, but Kogas' gas sales decreased by 10.4% to 1.63 million ton, which increased inventories. The company also recently delayed signing a new supply agreement with Indonesia's Tangguh project because of the ample availability of LNG in the marketplace. Kogas also expects to have a higher-than-normal LNG surplus of 1.01 million ton by the end of March 2010 because of slow demand. Yet despite the negative picture, officials believe demand is poised to pick up and Kogas remains a buyer of LNG. It expects to import almost 4 million ton/y of extra LNG by the end of 2010, on top of an estimated 26.5 million ton /yr in 2009. Kogas has secured future LNG supplies from a number of sources in recent months, including an agreement to take 1.5 million ton/yr from Chevron's Gorgon project in Australia over 15 yr. Kogas will also take 2 million ton/yr from the $4.5 billion Yemen LNG project, led by Total, in which the South Korean company holds a 6% stake. Production at the 6.7 million ton/yr capacity plant started in October 20009. Kogas is also turning to alternative gas-related energy sources, having signed an agreement to invest $345 million in a dimethyl ether (DME) plant in Jubail, Saudi Arabia. According to Kogas, the plant would produce 300,000 ton/yr of DME from 2013.},
	issn = {0306395X},
	coden = {PEECD},
	language = {English},
	abbrev_source_title = {Pet. Econ.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

