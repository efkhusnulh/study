@CONFERENCE{Putri2024322,
	author = {Putri, Salsabila Amalia and Yuliansyah, Muhammad Zuhair and Sandi, Risky Tri},
	title = {Enhancing Customer Loyalty: Evaluating the Influence of Indomaret's Member Card and Mobile Application Loyalty Program},
	year = {2024},
	journal = {Proceedings of 2024 International Conference on Information Management and Technology, ICIMTech 2024},
	pages = {322 – 327},
	doi = {10.1109/ICIMTech63123.2024.10780892},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85215925461&doi=10.1109%2fICIMTech63123.2024.10780892&partnerID=40&md5=9839edfec1b860bd6321358110a5e8d6},
	affiliations = {School of Information Systems, Bina Nusantara University, Information Systems Department, Jakarta, 11480, Indonesia},
	abstract = {Within Indonesia's dynamic retail landscape, the advent of Indomaret's Member Card and Mobile Application Loyalty Program seeks to address the complex challenge of enhancing customer loyalty in the context of stiff competition from both brick-and-mortar stores and e-commerce platforms. This research delves into the efficiency of such loyalty programs in cementing customer allegiance, utilizing a quantitative methodology to probe the interrelations of perceived value, trust, ease of use, and customer satisfaction with loyalty. A structured survey disseminated via Google Forms, analyzed through SMART-PLS software, reveals that each of these variables significantly influences loyalty, with perceived value and trust surfacing as the most potent predictors. The study's results not only confirm the acceptance of all posited hypotheses but also illuminate the critical role of user-friendly interfaces and satisfying consumer interactions in fostering repeat patronage. The implications extend far beyond Indomaret's strategic initiatives, offering valuable insights for the wider retail sector on the importance of integrating customer expectations with seamless, trustworthy digital experiences. This synthesis of technological convenience with reward-driven loyalty programs emerges as a pivotal factor in ensuring sustained customer engagement and securing a competitive edge in the evolving marketplace. © 2024 IEEE.},
