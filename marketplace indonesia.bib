	doi = {10.18502/jfqhc.9.2.10648},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85142291694&doi=10.18502%2fjfqhc.9.2.10648&partnerID=40&md5=8f8c092270c6ed32085b8a050f888a95},
