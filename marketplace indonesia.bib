@ARTICLE{Berman1987289,
	author = {Berman, Peter and Ormond, Barbara A. and Gani, Ascobat},
	title = {Treatment use and expenditure on curative care in rural Indonesia},
	year = {1987},
	journal = {Health Policy and Planning},
	volume = {2},
	number = {4},
	pages = {289 – 300},
	doi = {10.1093/heapol/2.4.289},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-0023609059&doi=10.1093%2fheapol%2f2.4.289&partnerID=40&md5=d46436453d97002d39df12c4af681897},
	affiliations = {School of Hygiene and Public Health1, Johns Hopkins University, United States; School of Public Health, University of Indonesia, Indonesia},
	abstract = {Rural Indonesians face a diverse and complex marketplace in which they can seek treatment for perceived illness. This includes a wide range of informal, traditional and licensed allopathic public and private providers. This paper describes the richness of household care-seeking behaviour in terms of utilization of different treatment alternatives and household spending on curative care. Better understanding of these patterns is an important prerequisite for the development of new policy initiatives to strengthen health care financing without negatively affecting service equity and effectiveness. Utilization and expenditure for different types of providers are presented in aggregate for the sample population from rural West Java. More detailed breakdowns are given by perceived severity of illness, specific diagnostic categories and income quartiles. Treatment prices and travel costs per treatment contact are also calculated. The data highlight the importance of informal sources of treatment in care-seeking as well as the importance of public and private licensed providers in spending. Rural districts with only a few licensed providers show much variety in prices for treatment by these providers in their public and private roles. Lower income patients use less treatment overall and less modern licensed care. Overall, there is much 'willingness to use' treatment and moderate 'willingness to pay'. © 1987 Oxford University Press.},
	keywords = {diagnosis; diagnosis related group; economic aspect; ethnic or racial aspects; health care cost; health care utilization; human; indonesia; lowest income group; rural population; short survey; socioeconomics},
